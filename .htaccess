# Front controller for Apache / LiteSpeed.
# Works at the document root or in a subfolder without touching httpd.conf.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny source, config, dependencies and SQL FIRST.
    # This has to come before the "serve existing files" rule below: that rule
    # ends in [L], so anything matching it stops rewriting immediately and this
    # block would never be reached.
    RewriteRule ^(config|src|templates|vendor|sql)/ - [F,L]

    # Serve existing files/directories directly (assets, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the Slim front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Belt and braces for hosts without mod_rewrite: never serve these by extension.
<FilesMatch "\.(sql|md|json|lock|dist|ya?ml)$">
    Require all denied
</FilesMatch>

Options -Indexes
